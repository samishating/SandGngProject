# Copy to .env (local dev) and set the same values in the Vercel project's
# Environment Variables (separately for Preview/Production) for deploys.

# ---------- Supabase (auth + Postgres) ----------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never expose to the client. Used to create
# salesperson accounts (lib/supabase/admin.ts) and by the scripts in scripts/.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Project Settings -> Database in Supabase.
# DATABASE_URL: the pooled connection (port 6543, ?pgbouncer=true), used at
# runtime. DIRECT_URL: the non-pooled connection, used only by
# `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# ---------- Accounts ----------
# The temporary password every new account is created with. Optional; defaults
# to "login123" (lib/auth-constants.ts). Whoever receives it is forced through
# /login/set-password before any page will render, which is the only reason a
# shared secret is acceptable — so create accounts when the person is ready to
# use them, not weeks ahead.
TEMP_ACCOUNT_PASSWORD=

# ---------- Exchange rates ----------
# Vercel sends `Authorization: Bearer <CRON_SECRET>` on scheduled invocations.
# Optional, but without it /api/cron/refresh-rates is publicly callable and
# anyone can drive requests at the upstream FX providers from your IP.
CRON_SECRET=

# ---------- Test payment simulator ----------
# Set to exactly "1" to enable /checkout/pay, a fake card form that always
# succeeds. Intended for exercising the order -> paid -> commission chain
# before real payments exist.
#
# The card number never leaves the browser and only the test PAN
# 4242 4242 4242 4242 is accepted, so no real card can be captured — but the
# page will still tell a visitor their order is paid when no money moved.
# TURN THIS OFF BEFORE THE SITE GOES LIVE. While it is on, every admin page
# shows a banner saying so.
NEXT_PUBLIC_TEST_CHECKOUT=

# ---------- Site ----------
# Fallback origin for anything built server-side that has no request Origin
# header. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ---------- Resend (callback-request notification email) ----------
# Optional — without these, /api/callback-request still accepts
# submissions and logs them, it just won't email anyone.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
