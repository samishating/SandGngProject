# Copy to .env (local dev) and set the same values in the Vercel project's
# Environment Variables (separately for Preview/Production) for deploys.

# ---------- Supabase (auth + Postgres) ----------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never expose to the client. Used to
# invite salesperson accounts (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Project Settings -> Database in Supabase.
# DATABASE_URL: the pooled connection (port 6543, ?pgbouncer=true), used at
# runtime. DIRECT_URL: the non-pooled connection, used only by
# `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ten Stripe Price IDs — create these in the Stripe dashboard first, then
# run `npm run prisma:seed` to load them into the PlanPrice table. Only
# read at seed time, not at request time. The one-off plan has no
# monthly/yearly split (it's a single payment); Household and Family &
# elders each need both.
STRIPE_PRICE_ONEOFF_USD=
STRIPE_PRICE_ONEOFF_EUR=
STRIPE_PRICE_HOUSEHOLD_USD_MONTHLY=
STRIPE_PRICE_HOUSEHOLD_EUR_MONTHLY=
STRIPE_PRICE_HOUSEHOLD_USD_YEARLY=
STRIPE_PRICE_HOUSEHOLD_EUR_YEARLY=
STRIPE_PRICE_FAMILY_USD_MONTHLY=
STRIPE_PRICE_FAMILY_EUR_MONTHLY=
STRIPE_PRICE_FAMILY_USD_YEARLY=
STRIPE_PRICE_FAMILY_EUR_YEARLY=

# ---------- Site ----------
# Used as a fallback origin (e.g. in Stripe redirect/return URLs) when the
# request's Origin header isn't present. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ---------- Resend (callback-request notification email) ----------
# Optional — without these, /api/callback-request still accepts
# submissions and logs them, it just won't email anyone.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
