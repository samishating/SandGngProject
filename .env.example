# Copy to .env (local dev, via `vercel env pull` or manually) and set these
# in the Vercel project's Environment Variables for production.
# Without them, /api/callback-request still accepts submissions and logs
# them to the function's logs — it just won't email anyone.

# Resend (https://resend.com) API key used to send the notification email.
RESEND_API_KEY=

# Where "Request a call back" submissions get emailed.
NOTIFY_EMAIL=

# Optional — must be a verified sender/domain in Resend. Defaults to
# Resend's shared onboarding@resend.dev sender if omitted.
NOTIFY_FROM=
