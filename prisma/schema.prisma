generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALESPERSON
}

enum CommissionType {
  PERCENTAGE
  FLAT
}

enum CommissionScope {
  SALESPERSON_DEFAULT
  PLAN_SPECIFIC
}

enum StripeMode {
  PAYMENT
  SUBSCRIPTION
}

/// How a sale reached us. MANUAL is the only one in use today — sales are
/// recorded by an admin, since there is no online checkout. PAYPAL is here so
/// adding that later is a new value in use, not a schema migration; STRIPE
/// stays for the dormant webhook path.
enum SaleProvider {
  MANUAL
  PAYPAL
  STRIPE
}

/// Approval gate for a recorded sale. Everything is auto-APPROVED while
/// testing; PENDING exists so a future PayPal flow (or a salesperson-submitted
/// sale) can be held back from commission totals until confirmed.
enum SaleApproval {
  PENDING
  APPROVED
  REJECTED
}

enum SaleStatus {
  /// Placed at checkout and waiting for an agent to call the customer back.
  /// This — not ACTIVE — is where every new order starts: nothing is sold
  /// until someone has spoken to them and taken payment.
  AWAITING_CALLBACK
  /// The callback happened and the plan is running.
  ACTIVE
  CANCELED
  REFUNDED
}

enum SaleEventType {
  INITIAL_PURCHASE
  RENEWAL
  REFUND_REVERSAL
}

/// id matches Supabase auth.users.id (uuid); created alongside the Supabase
/// invite (see lib/supabase/admin.ts) — no cross-schema Prisma FK to auth.users.
model Profile {
  id          String   @id
  email       String   @unique
  role        Role
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Accounts are created by an admin with a shared temporary password, so
  /// every new one starts here. The admin and dashboard layouts refuse to
  /// render while this is true and send the user to /login/set-password —
  /// that redirect is the only thing keeping the temp password short-lived,
  /// so it must stay in front of every authenticated page.
  mustChangePassword Boolean @default(true)

  referralTags     ReferralTag[]
  commissionRules  CommissionRule[]
  sales            Sale[]
  commissionEvents CommissionEvent[]
}

model ReferralTag {
  id            String   @id @default(cuid())
  tag           String   @unique // used as ?ref=<tag>
  salesperson   Profile  @relation(fields: [salespersonId], references: [id])
  salespersonId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  sales Sale[]

  @@index([salespersonId])
}

/// The plan set itself is seeded from code; its USD prices are admin-editable
/// at /admin/plans (see PlanPrice), as are commission rules.
model Plan {
  id          String   @id @default(cuid())
  key         String   @unique // "one-off" | "household" | "family-elders"
  name        String
  isRecurring Boolean
  createdAt   DateTime @default(now())

  prices          PlanPrice[]
  commissionRules CommissionRule[]
  sales           Sale[]
}

/// USD is the single source of truth for every price — the admin edits these
/// and nothing else. EUR and GBP are derived at render time from ExchangeRate,
/// so there is exactly one number per plan/interval to keep straight instead
/// of one per currency.
model PlanPrice {
  id        String @id @default(cuid())
  plan      Plan   @relation(fields: [planId], references: [id])
  planId    String
  interval  String // "one_time" (the one-off plan only) | "month" | "year"
  amountUsd Int // cents, USD

  updatedAt DateTime @updatedAt

  @@unique([planId, interval])
}

/// One row per non-USD currency, refreshed daily by /api/cron/refresh-rates.
/// `rate` is how many units of `currency` one USD buys. Rows are only ever
/// overwritten on a successful fetch, so an API outage leaves yesterday's
/// rate in place rather than blanking out the pricing page.
model ExchangeRate {
  currency  String   @id // "eur" | "gbp"
  rate      Decimal  @db.Decimal(14, 6)
  source    String // which API the figure came from
  rateDate  String // the date the provider stamped on it (YYYY-MM-DD)
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Commission is resolved from the applicable active rule at the moment a sale
/// is recorded, then snapshotted onto CommissionEvent — editing a rule later
/// never rewrites history. See lib/commission.ts.
model CommissionRule {
  id            String          @id @default(cuid())
  salesperson   Profile         @relation(fields: [salespersonId], references: [id])
  salespersonId String
  scope         CommissionScope
  plan          Plan?           @relation(fields: [planId], references: [id])
  planId        String? // null when scope = SALESPERSON_DEFAULT
  type          CommissionType
  currency      String? // required for FLAT, ignored for PERCENTAGE
  value         Decimal         @db.Decimal(10, 4) // 10.0000 = 10% if PERCENTAGE, cents if FLAT
  isActive      Boolean         @default(true)
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  commissionEvents CommissionEvent[]

  @@index([salespersonId, planId, isActive])
}

model Sale {
  id String @id @default(cuid())

  /// Short human-quotable order code (6 chars, e.g. "K7M2QP"). The cuid above
  /// is unusable over the phone; this is what a customer reads out and what
  /// staff search on. Generated from an alphabet with no 0/O/1/I/L so it
  /// survives being spoken aloud and written down. See lib/order-reference.ts.
  reference String @unique

  referralTag   ReferralTag? @relation(fields: [referralTagId], references: [id])
  referralTagId String?
  salesperson   Profile?     @relation(fields: [salespersonId], references: [id])
  salespersonId String?
  plan          Plan         @relation(fields: [planId], references: [id])
  planId        String
  currency      String

  provider SaleProvider @default(MANUAL)
  approval SaleApproval @default(APPROVED)

  /// What the customer actually paid, in `currency`, plus the USD figure it
  /// was derived from. Both are snapshotted: today's rate is not tomorrow's,
  /// and a sale must not silently reprice itself when the rate moves.
  amount    Int
  amountUsd Int

  /// Captured at checkout. Stored as real columns rather than packed into
  /// `note` because an agent working the callback queue needs to see who to
  /// ring and on what number at a glance.
  customerName  String?
  customerEmail String?
  customerPhone String?
  note          String?

  /// Stamped when an agent marks the callback done, so the queue can show how
  /// long someone has been waiting and who has already been dealt with.
  calledBackAt DateTime?

  // All Stripe-specific now that checkout is offline. Nothing writes these
  // today; they stay so the dormant webhook path still compiles and so
  // re-enabling Stripe later doesn't need a destructive migration.
  stripeCustomerId        String?
  stripeCheckoutSessionId String?     @unique
  stripeSubscriptionId    String?     @unique // null for the one-time plan
  stripePaymentIntentId   String?     @unique // used to trace charge.refunded back to this sale
  mode                    StripeMode?

  status    SaleStatus @default(AWAITING_CALLBACK)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  commissionEvents CommissionEvent[]

  @@index([salespersonId])
  @@index([referralTagId])
  // Drives the "waiting for callback" queue each agent opens from their nav.
  @@index([salespersonId, status])
}

model CommissionEvent {
  id            String  @id @default(cuid())
  sale          Sale    @relation(fields: [saleId], references: [id])
  saleId        String
  salesperson   Profile @relation(fields: [salespersonId], references: [id])
  salespersonId String

  eventType SaleEventType

  // Both null for manually recorded sales, which have no upstream event to
  // deduplicate against. Still unique for the Stripe path — Postgres treats
  // NULLs as distinct, so any number of manual events coexist happily.
  stripeEventId  String? @unique // idempotency/dedup key
  stripeObjectId String? // checkout session id, invoice id, or charge id

  // The PaymentIntent behind this specific charge — how a later
  // charge.refunded event finds its way back to this exact commission
  // event. Not unique: a REFUND_REVERSAL intentionally shares the same
  // payment intent as the event it reverses.
  stripePaymentIntentId String?

  grossAmount Int // cents actually charged (negative for REFUND_REVERSAL)
  currency    String

  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  commissionRuleId String?
  commissionType   CommissionType? // snapshot, null if no rule matched
  commissionValue  Decimal?        @db.Decimal(10, 4) // snapshot
  commissionAmount Int // computed cents, snapshot, negative for reversals

  createdAt DateTime @default(now())

  @@index([salespersonId, createdAt])
  @@index([stripePaymentIntentId])
}
